module(name = "bazel-cxx-qt")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "llvm", version = "0.8.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "cxx.rs", version = "1.0.205")


toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains", dev_dependency = True)
toolchains.toolchain(
    edition = "2024",
    version = "1.99.0",
)

use_repo(toolchains, "default_rust_toolchains")
register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    dev_dependency = True
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-gnullvm",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnullvm",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

crate.annotation(
  crate = "cxx-qt",
  additive_build_file = "//third_party:cxx-qt.additive.BUILD",
  extra_aliased_targets = {
    "_cxx-qt": "_cxx-qt",
    "_cxx-qt-generated": "_cxx-qt-generated",
  },
  link_deps = ["@crates//:_cxx-qt-generated"],
  rustc_flags = ["--cfg", "cxxqt_qt_version_major=\"6\""],
  gen_build_script = "off",
)

crate.annotation(
  crate = "cxx-qt-lib",
  additive_build_file = "//third_party:cxx-qt-lib.additive.BUILD",
  extra_aliased_targets = {
    "_cxx-qt-lib": "_cxx-qt-lib",
    "_cxx-qt-lib-generated": "_cxx-qt-lib-generated",
  },
  link_deps = ["@crates//:_cxx-qt-lib-generated"],
  rustc_flags = ["--cfg", "cxxqt_qt_version_major=\"6\""],
  gen_build_script = "off",
)

crate.annotation(
  crate = "cxx",
  gen_build_script = "off",
  additive_build_file = "//third_party:cxx.additive.BUILD",
  extra_aliased_targets = {
    "_cc_lib": "_cc_lib",
  },
  link_deps = ["@crates//:_cc_lib"]
)

inject_repo(crate, "bazel-cxx-qt")


