bazel_dep(name = "cxx.rs", version = "1.0.205")

qt_download = use_extension("@cxx-qt-bazel//cxx-qt-bazel:extensions.bzl", "qt_download")
use_repo(qt_download, "qt")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

crate.annotation(
  crate = "cxx",
  gen_build_script = "off",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_cxx": "_bs_cxx",
  },
  link_deps = ["@crates//:_bs_cxx"]
)

crate.annotation(
  crate = "cxx-qt",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_cxx-qt": "_bs_cxx-qt",
    "_bs_cxx-qt-generated": "_bs_cxx-qt-generated",
  },
  rustc_flags = ["--cfg", "cxxqt_qt_version_major=\"6\""],
  gen_build_script = "off",
  link_deps = ["@crates//:_bs_cxx-qt-generated"],
)

crate.annotation(
  crate = "cxx-qt-lib",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_cxx-qt-lib-generated": "_bs_cxx-qt-lib-generated",
  },
  rustc_flags = ["--cfg", "cxxqt_qt_version_major=\"6\""],
  gen_build_script = "off",
  link_deps = ["@crates//:_bs_cxx-qt-lib-generated"],
)

crate.annotation(
  crate = "qtbridge-type-lib",
  gen_build_script = "off",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_qtbridge_type_lib": "_bs_qtbridge_type_lib",
    "rustconv": "rustconv",
  },
  link_deps = ["@crates//:_bs_qtbridge_type_lib"],
)

crate.annotation(
  crate = "qtbridge-runtime",
  gen_build_script = "off",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_qtbridge_runtime": "_bs_qtbridge_runtime",
  },
  link_deps = ["@crates//:_bs_qtbridge_runtime"],
)

crate.annotation(
  crate = "qtbridge-interfaces",
  gen_build_script = "off",
  additive_build_file = "//third_party:qt.additive.BUILD",
  extra_aliased_targets = {
    "_bs_qtbridge_interfaces": "_bs_qtbridge_interfaces",
  },
  link_deps = ["@crates//:_bs_qtbridge_interfaces"],
)

inject_repo(crate, "cxx-qt-bazel")
inject_repo(crate, "qt")
inject_repo(crate, "cxx.rs")

